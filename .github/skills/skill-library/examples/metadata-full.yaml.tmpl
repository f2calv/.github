$schema: ../skill-metadata.schema.json
id: example-skill
version: '1.0.0'
facets: [architecture, integration]
license: Apache-2.0
notices:
  - docs/example-NOTICE.txt
required:
  - id: example-dependency
    version: '1.0.0'
optional:
  - id: example-extra
    version: '1.0.0'
    selectionKey: extra-guidance
    reason: Include additional guidance when the caller explicitly selects it.
externalFiles:
  - path: docs/example-instructions.md
    kind: instruction
    loadingPurpose: Follow the reviewed conventions for this synthetic integration.
  - path: docs/example-external-NOTICE.txt
    kind: notice
    loadingPurpose: Include the separate reviewed notice for this synthetic integration.
tooling:
  - id: powershell
    versionRequirement: '>=7.4.0'
    scope: authoring
    required: true
  - id: python
    versionRequirement: '3.11.0'
    scope: build
    required: false