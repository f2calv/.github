{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill library repository defaults",
  "type": "object",
  "additionalProperties": false,
  "required": ["license"],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "notices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*[\\\\:\\x00-\\x1f])[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
      }
    }
  }
}
