{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.com/schemas/dotnet-release-train-state.schema.json",
    "title": ".NET release train state",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schemaVersion",
        "trainId",
        "createdAtUtc",
        "updatedAtUtc",
        "planFingerprint",
        "packageScope",
        "status",
        "layers",
        "repositories",
        "events"
    ],
    "properties": {
        "schemaVersion": {
            "const": 1
        },
        "trainId": {
            "type": "string",
            "minLength": 1
        },
        "createdAtUtc": {
            "type": "string",
            "format": "date-time"
        },
        "updatedAtUtc": {
            "type": "string",
            "format": "date-time"
        },
        "planFingerprint": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
        },
        "packageScope": {
            "enum": [
                "all",
                "internal"
            ]
        },
        "status": {
            "enum": [
                "planning",
                "prepared",
                "running",
                "paused",
                "failed",
                "stopped",
                "completed"
            ]
        },
        "layers": {
            "type": "array",
            "items": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "repositories": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/repository"
            }
        },
        "events": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/event"
            }
        }
    },
    "$defs": {
        "repository": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "key",
                "path",
                "remote",
                "visibility",
                "defaultBranch",
                "branch",
                "headSha",
                "preparedHeadSha",
                "stage",
                "disposition",
                "classification",
                "producedPackageIds",
                "dependencies",
                "packageAssessments",
                "plannedChanges",
                "validationCommands",
                "packageAvailability"
            ],
            "properties": {
                "key": {
                    "type": "string",
                    "minLength": 1
                },
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "remote": {
                    "type": "string",
                    "minLength": 1
                },
                "visibility": {
                    "enum": [
                        "public",
                        "private"
                    ]
                },
                "defaultBranch": {
                    "type": "string",
                    "minLength": 1
                },
                "branch": {
                    "type": "string",
                    "minLength": 1
                },
                "headSha": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{40}$"
                },
                "preparedHeadSha": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[0-9a-f]{40}$"
                },
                "stage": {
                    "enum": [
                        "discovered",
                        "prepared",
                        "pushed",
                        "pr-open",
                        "checks-passed",
                        "merged",
                        "release-complete",
                        "packages-available",
                        "completed"
                    ]
                },
                "disposition": {
                    "enum": [
                        "active",
                        "failed",
                        "skipped",
                        "stopped"
                    ]
                },
                "classification": {
                    "enum": [
                        "dependency-only",
                        "mixed",
                        "unchanged"
                    ]
                },
                "producedPackageIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "dependencies": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/dependency"
                    }
                },
                "packageAssessments": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/packageAssessment"
                    }
                },
                "plannedChanges": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/plannedChange"
                    }
                },
                "validationCommands": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "issueNumber": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "pullRequestNumber": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "pullRequestHeadSha": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[0-9a-f]{40}$"
                },
                "pullRequestBaseRef": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "minLength": 1
                },
                "pullRequestBaseSha": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[0-9a-f]{40}$"
                },
                "checkSuiteIds": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "pullRequestWorkflowRunId": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "releaseWorkflowRunId": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "mergeSha": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[0-9a-f]{40}$"
                },
                "releaseVersion": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "releaseTag": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "releaseId": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 1
                },
                "releaseCommitSha": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[0-9a-f]{40}$"
                },
                "packageAvailability": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/packageAvailability"
                    }
                },
                "lastError": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "stage": {
                                "enum": [
                                    "pr-open",
                                    "checks-passed",
                                    "merged",
                                    "release-complete",
                                    "packages-available",
                                    "completed"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "pullRequestNumber",
                            "pullRequestBaseRef",
                            "pullRequestBaseSha",
                            "pullRequestHeadSha"
                        ],
                        "properties": {
                            "pullRequestNumber": {
                                "type": "integer"
                            },
                            "pullRequestBaseRef": {
                                "type": "string"
                            },
                            "pullRequestBaseSha": {
                                "type": "string"
                            },
                            "pullRequestHeadSha": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "stage": {
                                "enum": [
                                    "checks-passed",
                                    "merged",
                                    "release-complete",
                                    "packages-available",
                                    "completed"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "checkSuiteIds",
                            "pullRequestWorkflowRunId"
                        ],
                        "properties": {
                            "checkSuiteIds": {
                                "type": "array",
                                "minItems": 1
                            },
                            "pullRequestWorkflowRunId": {
                                "type": "integer"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "stage": {
                                "enum": [
                                    "merged",
                                    "release-complete",
                                    "packages-available",
                                    "completed"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "mergeSha"
                        ],
                        "properties": {
                            "mergeSha": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "stage": {
                                "enum": [
                                    "release-complete",
                                    "packages-available",
                                    "completed"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "releaseWorkflowRunId",
                            "releaseVersion",
                            "releaseTag",
                            "releaseId",
                            "releaseCommitSha"
                        ],
                        "properties": {
                            "releaseWorkflowRunId": {
                                "type": "integer"
                            },
                            "releaseVersion": {
                                "type": "string"
                            },
                            "releaseTag": {
                                "type": "string"
                            },
                            "releaseId": {
                                "type": "integer"
                            },
                            "releaseCommitSha": {
                                "type": "string"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "stage": {
                                "enum": [
                                    "packages-available"
                                ]
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "producedPackageIds": {
                                "type": "array",
                                "minItems": 1
                            },
                            "packageAvailability": {
                                "type": "array",
                                "minItems": 1
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "stage": {
                                "const": "completed"
                            },
                            "producedPackageIds": {
                                "type": "array",
                                "minItems": 1
                            }
                        },
                        "required": [
                            "stage",
                            "producedPackageIds"
                        ]
                    },
                    "then": {
                        "properties": {
                            "packageAvailability": {
                                "type": "array",
                                "minItems": 1
                            }
                        }
                    }
                }
            ]
        },
        "dependency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "producerKey",
                "packageIds",
                "currentVersion"
            ],
            "properties": {
                "producerKey": {
                    "type": "string",
                    "minLength": 1
                },
                "packageIds": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "currentVersion": {
                    "type": "string",
                    "minLength": 1
                },
                "targetVersion": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "availability": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/packageAvailability"
                    }
                }
            }
        },
        "plannedChange": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "path",
                "packageId",
                "currentVersion",
                "targetVersion"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "packageId": {
                    "type": "string",
                    "minLength": 1
                },
                "currentVersion": {
                    "type": "string",
                    "minLength": 1
                },
                "targetVersion": {
                    "type": [
                        "string",
                        "null"
                    ]
                }
            }
        },
        "packageAssessment": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "packageId",
                "currentVersion",
                "newestObservedVersion",
                "decision",
                "policy",
                "condition",
                "assessmentEvidence"
            ],
            "properties": {
                "packageId": {
                    "type": "string",
                    "minLength": 1
                },
                "currentVersion": {
                    "type": "string",
                    "minLength": 1
                },
                "newestObservedVersion": {
                    "type": "string",
                    "minLength": 1
                },
                "selectedVersion": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "decision": {
                    "enum": [
                        "update",
                        "current",
                        "held"
                    ]
                },
                "policy": {
                    "enum": [
                        "unrestricted",
                        "major-ceiling",
                        "exact-hold"
                    ]
                },
                "permittedMajor": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "minimum": 0
                },
                "permittedVersion": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "newestPermittedVersion": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "condition": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "holdReason": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "holdSource": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "assessmentEvidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/packageAssessmentEvidence"
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "decision": {
                                "const": "update"
                            }
                        },
                        "required": [
                            "decision"
                        ]
                    },
                    "then": {
                        "required": [
                            "selectedVersion"
                        ],
                        "properties": {
                            "selectedVersion": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "policy": {
                                "enum": [
                                    "major-ceiling",
                                    "exact-hold"
                                ]
                            }
                        },
                        "required": [
                            "policy"
                        ]
                    },
                    "then": {
                        "required": [
                            "holdReason",
                            "holdSource"
                        ],
                        "properties": {
                            "holdReason": {
                                "type": "string",
                                "minLength": 1
                            },
                            "holdSource": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "policy": {
                                "const": "major-ceiling"
                            }
                        },
                        "required": [
                            "policy"
                        ]
                    },
                    "then": {
                        "required": [
                            "permittedMajor",
                            "newestPermittedVersion"
                        ],
                        "properties": {
                            "permittedMajor": {
                                "type": "integer"
                            },
                            "newestPermittedVersion": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "policy": {
                                "const": "exact-hold"
                            }
                        },
                        "required": [
                            "policy"
                        ]
                    },
                    "then": {
                        "required": [
                            "permittedVersion"
                        ],
                        "properties": {
                            "permittedVersion": {
                                "type": "string",
                                "minLength": 1
                            }
                        }
                    }
                }
            ]
        },
        "packageAssessmentEvidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "projectPath",
                "targetFramework",
                "configuration",
                "currentVersion",
                "queryCommand",
                "observedAtUtc"
            ],
            "properties": {
                "projectPath": {
                    "type": "string",
                    "minLength": 1
                },
                "targetFramework": {
                    "type": "string",
                    "minLength": 1
                },
                "configuration": {
                    "enum": [
                        "Debug",
                        "Release"
                    ]
                },
                "currentVersion": {
                    "type": "string",
                    "minLength": 1
                },
                "queryCommand": {
                    "type": "string",
                    "minLength": 1
                },
                "observedAtUtc": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "packageAvailability": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "packageId",
                "version",
                "sourceUri",
                "checkedAtUtc"
            ],
            "properties": {
                "packageId": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "sourceUri": {
                    "const": "https://api.nuget.org/v3-flatcontainer/"
                },
                "checkedAtUtc": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "event": {
            "type": "object",
            "additionalProperties": false,
            "required": [
                "atUtc",
                "repositoryKey",
                "kind",
                "from",
                "to",
                "message"
            ],
            "properties": {
                "atUtc": {
                    "type": "string",
                    "format": "date-time"
                },
                "repositoryKey": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "kind": {
                    "enum": [
                        "train-status",
                        "repository-stage",
                        "repository-disposition",
                        "evidence"
                    ]
                },
                "from": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "to": {
                    "type": "string",
                    "minLength": 1
                },
                "message": {
                    "type": "string",
                    "minLength": 1
                }
            }
        }
    }
}