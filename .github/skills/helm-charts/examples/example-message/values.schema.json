{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["message"],
  "properties": {
    "global": {
      "type": "object",
      "additionalProperties": true
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "text"],
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether to emit the message ConfigMap."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "description": "Non-secret literal text stored in the ConfigMap."
        }
      }
    }
  }
}
