### Synthetic widget API - copy to requests/widgets.http

@baseUrl = {{$dotenv EXAMPLE_BASE_URL}}
@resourceId = 00000000-0000-0000-0000-000000000000

### Read a synthetic widget - expected 200 or 404
# @name getWidget
GET {{baseUrl}}/api/v1/widgets/{{resourceId}} HTTP/1.1
Accept: application/json

### Create a synthetic widget - expected 201, 400 or 409
# @name createWidget
# @note Mutates server state. Obtain separate approval for this POST; do not run the whole file.
POST {{baseUrl}}/api/v1/widgets HTTP/1.1
Content-Type: application/json
Accept: application/json

{
  "name": "example-widget"
}
